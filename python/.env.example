# Full-game shared-attention training on Apple Silicon.
# Run from python/ (the trainer reads exported environment variables, not files):
#   set -a
#   . ./.env.example
#   set +a
#   .venv/bin/python -u -m simulation.trainer
# Alternatively, copy this example to .env and source that file instead.
# Never source an environment file you do not trust: sourcing executes shell code.

# ======================== First training run ========================

BALATRO_DEVICE=mps

# Number of additional training iterations, including when resuming.
# An iteration collects episodes, then performs PPO updates on that experience.
# Start small to check runtime/memory; this is not enough to expect strong play.
BALATRO_ITERATIONS=20
BALATRO_EPISODES_PER_UPDATE=4
BALATRO_ROLLOUT_BATCH_SIZE=4
BALATRO_MINIBATCH_SIZE=16
BALATRO_PPO_EPOCHS=2

# Start with one deck/stake; broaden later, e.g. Red,Magic,Painted.
BALATRO_DECKS=Red
BALATRO_STAKE=White
BALATRO_SEED=12345

# Full runs include blind selection, play, shops, packs and consumables.
# Each episode ends on loss, this accepted-command limit, or the rejection limit.
# Clearing ante eight is a success metric; the engine continues into endless play.
# Reorders/purchases/etc. count as commands, not just hands played.
BALATRO_HORIZON=4096
BALATRO_MAX_CONSECUTIVE_REJECTIONS=32

# ============================= Learning =============================

BALATRO_LEARNING_RATE=3e-4
BALATRO_ENTROPY_COEFFICIENT=0.01
BALATRO_CLIP_RATIO=0.2
BALATRO_GAMMA=0.99
BALATRO_GAE_LAMBDA=0.95
BALATRO_MAX_GRADIENT_NORM=0.5

# Jointly trained per-object encoders and shared-attention architecture.
# Width must be divisible by heads. Keep these identical when resuming.
BALATRO_MODEL_WIDTH=64
BALATRO_MODEL_HEADS=4
BALATRO_MODEL_DEPTH=2

# ===================== Evaluation and checkpoints ===================

# Evaluation uses separate seeds and deterministic action selection.
# It shares the training deck/stake selection and episode horizon.
BALATRO_EVALUATION_INTERVAL=5
BALATRO_EVALUATION_EPISODES=4
BALATRO_EVALUATION_SEED=20260728

# Paths are relative to python/. Use new names for independent experiments.
# Checkpoint is overwritten after evaluation and when the trainer exits.
BALATRO_CHECKPOINT_PATH=tmp/full_game_mps.pt
BALATRO_TENSORBOARD_LOG_DIR=runs/full_game_mps

# Resume only a new full-game checkpoint, not the old ppo_blind*.pt weights.
# "best" and "latest" aliases are not supported: specify an actual path.
# Model configuration and resource limits must match the saved checkpoint.
# Resuming retains the completed-iteration count and adds BALATRO_ITERATIONS.
# BALATRO_RESUME_CHECKPOINT=tmp/full_game_mps.pt
BALATRO_RESUME_OPTIMIZER=true

# ======================== Resource safeguards =======================

# Variable-length collections are not padded to these limits for a single game.
# Oversized observations/batches fail explicitly rather than being truncated.
# Lower minibatch/rollout batch sizes first if memory use is too high.
BALATRO_LIMITS_MAX_COLLECTION_ROWS=512
BALATRO_LIMITS_MAX_TOKENS=1024
BALATRO_LIMITS_MAX_BATCH_ATTENTION_CELLS=4194304

# ============================= Rewards ==============================

BALATRO_REWARDS_CLEARED_BLIND=1.0
BALATRO_REWARDS_ANTE_EIGHT=10.0
BALATRO_REWARDS_LOSS=-1.0
BALATRO_REWARDS_REJECTED_ATTEMPT=-0.1

# ============================== Output ==============================

# The trainer prints metrics after each training update, not every game action.
# Per-move terminal rendering is not enabled by an environment setting.
# View training/evaluation curves from another terminal in python/:
#   .venv/bin/tensorboard --logdir runs/full_game_mps
