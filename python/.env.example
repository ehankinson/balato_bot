# ================== Things you actually change ==================

# Total iterations. When resuming, this is the final total, not extra.
BALATRO_ITERATIONS=10000

# Two-pass training:
#   Pass 1 (explore, fresh model):    entropy 0.01, lr 3e-4
#   Pass 2 (commit, resume the best): entropy 0.001, lr 1e-4
BALATRO_ENTROPY_COEFFICIENT=0.01
BALATRO_LEARNING_RATE=3e-4

# Resume training instead of starting fresh: "best", "latest", or a path.
# Leave commented out for pass 1, set for pass 2.
# BALATRO_RESUME_CHECKPOINT=best
BALATRO_RESUME_OPTIMIZER=false

# Name runs so TensorBoard curves are easy to tell apart (e.g. explore/commit).
# BALATRO_RUN_NAME=explore

# Fix the seed to compare configs fairly. Unset = new random seed each run.
# BALATRO_SEED=12345

# ==================== Leave alone unless broken ===================

BALATRO_EPISODES_PER_UPDATE=1024  # wild eval swings? try 2048
BALATRO_MINIBATCH_SIZE=512        # CUDA out of memory? try 256
BALATRO_PPO_EPOCHS=4
BALATRO_MAX_STEPS=20
BALATRO_CLIP_RATIO=0.2
BALATRO_GAMMA=0.99
BALATRO_GAE_LAMBDA=0.95
BALATRO_MAX_GRADIENT_NORM=0.5
BALATRO_HIDDEN_SIZE=256           # changing this breaks old checkpoints

# ======================= Targets & evaluation =====================

# Train 20% on 300 blinds, 80% on 450. Eval stays evenly split.
BALATRO_TRAIN_TARGETS=300:1,450:4
BALATRO_EVAL_TARGETS=300,450
BALATRO_EVAL_INTERVAL=100
BALATRO_EVAL_EPISODES=1000
BALATRO_EVAL_SEED=20260728

# =========================== Runtime ==============================

BALATRO_DEVICE=cuda
BALATRO_ROLLOUT_WORKERS=15
BALATRO_CONSOLE_LOG_INTERVAL=5
BALATRO_CHART_INTERVAL=5
BALATRO_PROFILE=false
