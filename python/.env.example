# Training length and batch sizes
# When resuming, iterations is the final total iteration, not additional work.
BALATRO_ITERATIONS=10000

# EPISODES PER UPDATE = how many games the bot plays before studying them.
# If training results jump wildly between iterations, try MORE (2048).
# If each iteration is too slow or uses too much RAM, try LESS (512).
# 1024 is already a strong default; normally leave this alone.
BALATRO_EPISODES_PER_UPDATE=1024

# PPO EPOCHS = how many times it studies the same group of games.
# If learning is extremely slow, try 5 or 6.
# If it improves and then quickly destroys that improvement, try 2 or 3.
# Too many means it memorizes old games instead of collecting fresh experience.
BALATRO_PPO_EPOCHS=4

# MINIBATCH SIZE = how many game decisions the GPU studies at once.
# If CUDA runs out of memory, lower this to 256 or 128.
# If the GPU has lots of free memory, 1024 may be slightly smoother/faster.
# This mostly affects speed/memory, not what strategy the bot wants.
BALATRO_MINIBATCH_SIZE=512

# MAX STEPS = emergency stop so a broken bot cannot play forever.
# Leave this at 20 unless a valid game can genuinely require more than 20 actions.
BALATRO_MAX_STEPS=20

# PPO hyperparameters
# LEARNING RATE = how hard the bot changes its brain after studying.
# Training a NEW model: start around 3e-4.
# Improving an EXISTING good model: use around 5e-5.
# If eval rises and then crashes, LOWER it (for example 2e-5).
# If nothing changes for hundreds of early iterations, RAISE it slightly.
BALATRO_LEARNING_RATE=5e-5

# CLIP RATIO = guard rail limiting how different one update may make the bot.
# Usually leave this at 0.2.
# If one update suddenly ruins a good policy, try 0.1 or 0.15.
# If the policy barely changes even with a useful reward, try 0.25.
BALATRO_CLIP_RATIO=0.2

# ENTROPY = the bot's curiosity/randomness while TRAINING.
# If it repeats one bad strategy and never tries alternatives, RAISE it
# slightly (for example 0.002).
# If it already knows a good strategy but training keeps making random mistakes,
# LOWER it (for example 0.0005).
# Do not make it zero too early or the bot may never discover better strategies.
BALATRO_ENTROPY_COEFFICIENT=0.001

# GAMMA = how much the bot cares that an action helps it WIN LATER.
# 0.99 says an early discard still deserves credit for a later win.
# If it greedily takes immediate points instead of planning, try 0.995.
# If rewards become very noisy and it cannot connect actions to results,
# try 0.97 or 0.98. Normally leave this at 0.99.
BALATRO_GAMMA=0.99

# GAE LAMBDA = how far backward the bot spreads credit/blame after a game.
# If an early discard should get credit for a hand made later, try 0.97.
# If training is noisy and blames early actions too randomly, try 0.90.
# This is subtle; leave it at 0.95 unless diagnosing credit assignment.
BALATRO_GAE_LAMBDA=0.95

# MAX GRADIENT NORM = emergency brake for abnormally huge brain updates.
# If losses spike or training becomes unstable, lower it to 0.25.
# If learning is being heavily clipped and barely moves, raise it to 1.0.
# Usually leave this safety setting at 0.5.
BALATRO_MAX_GRADIENT_NORM=0.5

# HIDDEN SIZE = physical size/capacity of the bot's brain.
# 512 can learn more complicated patterns but is slower and uses more memory.
# 128 is faster but may be too simple. 256 is a good current default.
# IMPORTANT: changing this prevents loading an existing 256-size checkpoint;
# only change it when starting a brand-new model.
BALATRO_HIDDEN_SIZE=256

# Resume the strongest saved policy with a fresh optimizer.
# Use "latest", "best", or a checkpoint path.
BALATRO_RESUME_CHECKPOINT=best
BALATRO_RESUME_OPTIMIZER=false

# Train 20% on 300-point blinds and 80% on 450-point blinds.
# Evaluation remains evenly split so regressions at 300 remain visible.
BALATRO_TRAIN_TARGETS=300:1,450:4
BALATRO_EVAL_TARGETS=300,450

# Deterministic evaluation and checkpointing
BALATRO_EVAL_INTERVAL=100
BALATRO_EVAL_EPISODES=1000
BALATRO_EVAL_SEED=20260728

# Runtime and logging
BALATRO_DEVICE=cuda
BALATRO_ROLLOUT_WORKERS=15
BALATRO_CONSOLE_LOG_INTERVAL=5
BALATRO_CHART_INTERVAL=5
BALATRO_PROFILE=false

# Optional overrides
# BALATRO_SEED=12345
# BALATRO_RUN_NAME=focused_450_finetune
# BALATRO_LOG_DIR=runs
# BALATRO_CHECKPOINT_DIR=tmp
# BALATRO_CHECKPOINT=tmp/last_trained.pt
# BALATRO_BEST_CHECKPOINT=tmp/best_model.pt
